# Copy this file to .env (same folder) and fill in what you need.
# Every value is optional.

# Port the server listens on
PORT=3001

# AI Tutor: answers "/ask <ques tion>" in chat. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Admin overview at /api/admin?key=<ADMIN_KEY> — use a long random string
ADMIN_KEY=

# Only needed when the frontend runs on a different domain (comma separated)
# CLIENT_ORIGIN=https://your-frontend.vercel.app

# Where room data is saved (default: server/data)
# DATA_DIR=./data

# ---------- Pro subscription (Razorpay) ----------
# Get keys at https://dashboard.razorpay.com → Settings → API Keys (use Test Mode keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → add https://<your-server>/api/billing/webhook with event "order.paid"
RAZORPAY_WEBHOOK_SECRET=

# Prices in rupees (defaults: 149 / 1199)
# PRO_PRICE_MONTHLY=149
# PRO_PRICE_YEARLY=1199

# ---------- Video calls (LiveKit) ----------
# LiveKit Cloud: https://cloud.livekit.io → create a project → Settings → Keys
# (or self-host the open-source LiveKit server and use its URL + keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
