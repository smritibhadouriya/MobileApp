# Web: not needed locally (Vite forwards /socket.io to localhost:3001).
#
# Android app: REQUIRED. The app runs from files on the phone, so it must know where the server is.
#   Same Wi-Fi test:   VITE_SERVER_URL=http://192.168.1.5:3001   (your PC's IP, see `ipconfig`)
#   Deployed server:   VITE_SERVER_URL=https://your-server.onrender.com
# VITE_SERVER_URL=

# Optional: base URL used in invite links (defaults to VITE_SERVER_URL in the app)
# VITE_PUBLIC_URL=
